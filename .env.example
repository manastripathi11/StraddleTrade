# ==============================================================================
# BYBIT CREDENTIALS (TESTNET)
# ==============================================================================
# Obtain Testnet API credentials from: https://testnet.bybit.com/app/user/api-management
# Permissions required: Unified Trading Account (Read-Write for Orders & Positions)
BYBIT_API_KEY=YOUR_BYBIT_TESTNET_API_KEY
BYBIT_API_SECRET=YOUR_BYBIT_TESTNET_API_SECRET

# ==============================================================================
# ENVIRONMENT & NETWORK CONFIGURATION
# ==============================================================================
# Use TESTNET by default to protect funds. Never set to false unless explicitly intending live trading.
BYBIT_TESTNET=true
TRADING_ENVIRONMENT=testnet

# ==============================================================================
# STRATEGY EXECUTION SETTINGS
# ==============================================================================
# Master safety switch: Must be set to true to submit actual orders to exchange.
# When false, the application starts in dry-run mode and logs what would be executed.
STRATEGY_ENABLED=false

# Strategy Level:
# 1 = Level 1: Naked Short Straddle (Position entry and monitoring, no automated SL/TP)
# 2 = Level 2: Automated Risk Management (+1% Stop-Loss, -2% Take-Profit)
STRATEGY_LEVEL=1

# Underlying reference instrument on Bybit (used to determine the ATM strike)
UNDERLYING_SYMBOL=BTCUSDT-SPOT.BYBIT

# Trade quantity for each option leg (Bybit BTC options minimum order size is 0.01 BTC)
TRADE_QUANTITY=0.01

# Option expiry preference: "nearest" selects closest unexpired delivery date.
# Alternatively specify an exact ISO date string (e.g. 2026-11-13)
EXPIRY_PREFERENCE=nearest

# ==============================================================================
# LEVEL 2 RISK MANAGEMENT THRESHOLDS
# ==============================================================================
# Stop-Loss: Exit if combined buyback cost increases by this percentage (0.01 = 1%)
STOP_LOSS_PCT=0.01

# Take-Profit: Exit if combined buyback cost decreases by this percentage (0.02 = 2%)
TAKE_PROFIT_PCT=0.02

# Maximum allowable age for option market quotes before flagging as stale (seconds)
MAX_QUOTE_STALE_SECS=30.0

# ==============================================================================
# APPLICATION & LOGGING SETTINGS
# ==============================================================================
LOG_LEVEL=INFO
